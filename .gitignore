# Secrets. The wildcard matters: a backup or a variant like .env.backup-...,
# .env.production or .env.old carries the same real keys as .env itself, and
# naming each form individually is how one of them eventually gets committed.
# Only the example, which holds no values, is tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
web/node_modules/
web/.next/
web/out/
*.tsbuildinfo

# Vercel
.vercel/

# Local data
data/
*.db
*.db-journal
*.sqlite3

# Downloaded model weights. Fetched by scripts/fetch_model.py, never committed.
Semantic Models/**
!Semantic Models/README.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
