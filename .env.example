# Copy to .env and fill in whatever you have. Every value is optional.
#
# With no keys at all the app still works: it ingests RSS, sitemaps, Google
# News, Hacker News and YouTube, deduplicates with the bundled local ONNX
# model, groups stories into events, and writes a digest using headlines. Add
# one LLM key and the digest gains written summaries and proper theming.

# ---------------------------------------------------------------- essentials

APP_NAME=Newsroom
# Set this on a hosted deployment so generated links and the RSS feed are
# absolute. Vercel sets VERCEL_URL automatically, which is used as a fallback.
PUBLIC_BASE_URL=

# Storage. Leave DATABASE_URL empty to use SQLite on the local filesystem.
# On Vercel the filesystem is ephemeral, so a Postgres URL is required there:
# Neon and Supabase both have a free tier that is ample for this.
DATABASE_URL=
DATA_DIR=./data

# Shared secret for the scheduler routes. Vercel Cron sends it automatically as
# a bearer token once it is set here. Without it, /api/cron/* is open to
# anyone, which is fine locally and a problem in public.
CRON_SECRET=

# Optional password on the whole API, sent by the browser as X-App-Password.
APP_PASSWORD=

# Let visitors paste their own provider keys in the UI. On, a public
# deployment costs you nothing because each visitor spends their own quota.
ALLOW_CLIENT_KEYS=1

# ------------------------------------------------------------- LLM providers
# You need at most one. Gemini, Groq, Cerebras and Cloudflare all have a usable
# free tier. Running locally, Ollama needs no key at all.

GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
HUGGINGFACE_API_KEY=

# Cloudflare Workers AI needs BOTH values: the account id is part of the URL,
# so a token on its own cannot address anything.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local model servers. Only reachable when the app runs on your own machine or
# a VM, never from a serverless deployment.
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
VLLM_BASE_URL=http://localhost:8000/v1

# Pin a model per provider, otherwise the picker's default is used.
GEMINI_MODEL=
GROQ_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# ---------------------------------------------------------------- embeddings
# "auto" picks the best available backend, which on a fresh install is the
# bundled ONNX model and needs no key. Named options: onnx, gemini_embed,
# cloudflare_embed, jina_embed, voyage_embed, openai_embed, cohere_embed,
# sentence_transformers, ollama_embed, hf_embed, lexical.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LOCAL_EMBED_ENABLED=1

JINA_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# ------------------------------------------------------------- news sources
# All optional. Each one switches on the matching source kind in the UI.

# Reddit now requires OAuth: the old unauthenticated .json endpoints return 403.
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:newsroom-aggregator:v1.0 (by /u/YOUR_USERNAME)

NEWSAPI_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=
CURRENTS_API_KEY=
MEDIASTACK_API_KEY=
GUARDIAN_API_KEY=
NYT_API_KEY=
MARKETAUX_API_KEY=
FINNHUB_API_KEY=
YOUTUBE_API_KEY=

# Web search backends, used to catch stories no configured feed carried.
SERPAPI_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SEARXNG_BASE_URL=

# -------------------------------------------------------------- ingestion

# Identify yourself honestly. Put a real contact in here on a public deployment.
USER_AGENT=NewsroomBot/1.0 (+https://example.com/about; personal news digest)
# Turning this off means ignoring sites that asked not to be crawled. Only do
# that for sites you have permission to read.
RESPECT_ROBOTS=1
PER_HOST_DELAY=1.0
FETCH_TIMEOUT=20
LOOKBACK_HOURS=24
MAX_ARTICLES_PER_SOURCE=60
# Fetching each article's full text improves summaries a lot and is the
# slowest stage. Turn off for a much faster run on feed summaries alone.
EXTRACT_FULLTEXT=1

# --------------------------------------------------------------- pipeline
# Leave these unset. Each embedding backend ships thresholds calibrated for its
# own vector space, and setting these overrides ALL of them with one number,
# which is almost never what you want. Tune only after running the eval:
#   python -m server.ops.eval
# DUPLICATE_THRESHOLD=0.92
# CLUSTER_THRESHOLD=0.70
SIMHASH_DISTANCE=3
DEDUP_WINDOW_HOURS=72
DIGEST_BULLETS=5

# --------------------------------------------------------------- delivery

# Send the digest automatically after a scheduled run. OFF by default: this is
# only meaningful on a real deployment running on a real schedule, and a fresh
# clone that starts mailing people would be a surprise. A workspace can
# override the channels and recipient in its own settings.
AUTO_DELIVER=0
AUTO_DELIVER_CHANNELS=email
AUTO_DELIVER_TO=


RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------- behaviour

# Create a starter workspace on an empty database.
DEMO_SEED=1
DEFAULT_PRESET=india-markets
DEFAULT_TIMEZONE=Asia/Kolkata
DEBUG=0

# Force a runtime tier instead of detecting it. Almost never needed.
# RUNTIME_TIER=server
# MAX_JOB_SECONDS=775
